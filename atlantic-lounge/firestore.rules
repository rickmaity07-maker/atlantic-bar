rules_version = '2';

// SECURITY MODEL
// ---------------
// This project has no client-facing Firestore access at all. Every read and
// write goes through app/api/reservation/route.ts on the server, using the
// Firebase Admin SDK — which is a privileged connection that IGNORES these
// rules entirely. These rules exist purely to guarantee that the browser
// (or anyone else using the public client SDK) can never read or write
// anything, even by mistake or misconfiguration.
//
// Note: rules alone do not protect this data. The Admin SDK service account
// key (FIREBASE_PRIVATE_KEY) is the real gatekeeper — anyone who has that
// key has full read/write access regardless of what's written here. Treat
// it like a password, never commit it, and only set it as a server-side
// env var (never NEXT_PUBLIC_*).

service cloud.firestore {
  match /databases/{database}/documents {

    // Reservations contain guest names + submission metadata.
    // No client read or write, under any condition.
    match /reservations/{reservationId} {
      allow read, write: if false;
    }

    // Explicit default-deny for every other path in this database.
    // Firestore already denies unmatched paths by default, but this makes
    // it impossible for a future collection to silently inherit an open
    // rule if someone edits this file carelessly later.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
