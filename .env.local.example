# --- Firebase Admin (server-side only, never exposed to the browser) ---
# From Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the quotes and \n escapes exactly as they appear in the downloaded JSON key
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Firebase Client SDK (safe to expose — used only for the admin login form) ---
# Firebase Console -> Project Settings -> General -> Your apps -> Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=atlantic-bar-863ce.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=atlantic-bar-863ce
NEXT_PUBLIC_FIREBASE_APP_ID=1:952619166607:web:xxxxxxxxxxxx

# --- Admin portal access control ---
# Comma-separated emails allowed to sign in at /admin/login — anyone else
# who signs up (or signs in) is rejected even with valid Firebase credentials
ADMIN_EMAILS=you@example.com

# --- Email notifications (Resend) ---
# Sign up free at resend.com, verify a sending domain (or use their test domain), and grab an API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must be a verified domain address once you're out of testing, e.g. reservations@atlanticlounge.com
RESEND_FROM_EMAIL="Atlantic Lounge Bar <onboarding@resend.dev>"
# Where new reservation notifications should be sent
RESERVATION_NOTIFY_EMAIL=you@example.com
