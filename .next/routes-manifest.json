  "dynamicRoutes": [
    {
      "page": "/api/admin/gallery/[id]",
      "regex": "^/api/admin/gallery/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/admin/gallery/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/admin/menu/[id]",
